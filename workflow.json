        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model:\"openai/gpt-oss-20b\",\n  temperature: 0.3,\n  response_format: { type: \"json_object\" },\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are a B2B lead qualification assistant. You will receive a lead's name, email, company, budget, industry and message. Return ONLY a raw JSON object (no markdown, no extra text) with exactly these keys: score (integer 0-100, overall lead quality), label (one of: hot, warm, cold), summary (one concise sentence explaining the score, written for a salesperson). Scoring guidance: clearly stated adequate budget and strong buying intent in the message = high score (70-100). Vague budget or exploratory message = medium score (40-69). No budget, very low budget, or clearly not a fit = low score (0-39).\"\n    },\n    {\n      role: \"user\",\n      content: JSON.stringify({ name: $json.name, email: $json.email, company: $json.company, budget: $json.budget, industry: $json.industry, message: $json.message })\n    }\n  ]\n}) }}",
        "options": {}
      },
      "id": "b8074e0e-b6c3-40f2-a88c-f19da4cd16c1",
      "name": "AI: Score Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -896,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Normalize Input').first().json;\nconst aiRaw = $input.first().json.choices[0].message.content;\nlet ai;\ntry {\n  ai = JSON.parse(aiRaw);\n} catch (e) {\n  ai = { score: 0, label: 'cold', summary: 'AI response could not be parsed: ' + aiRaw };\n}\nreturn [{\n  json: {\n    ...lead,\n    score: ai.score,\n    label: ai.label,\n    summary: ai.summary,\n    date: new Date().toISOString()\n  }\n}];"
      },
